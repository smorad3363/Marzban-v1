{
  "log": {
    "loglevel": "warning"
  },
  "routing": {
    "rules": [
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "BLOCK",
        "type": "field"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "SHADOWSOCKS + TCP",
      "listen": "0.0.0.0",
      "port": 2020,
      "protocol": "shadowsocks",
      "settings": {
        "password": "__AUTO_SS2022_SERVER_KEY__",
        "network": "tcp,udp",
        "clients": [],
        "method": "2022-blake3-aes-256-gcm"
      }
    },
    {
      "tag": "Shadowsocks TCP",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "shadowsocks",
      "settings": {
        "method": "chacha20-ietf-poly1305",
        "network": "tcp,udp",
        "clients": []
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "DIRECT"
    },
    {
      "protocol": "blackhole",
      "tag": "BLOCK"
    }
  ]
}
